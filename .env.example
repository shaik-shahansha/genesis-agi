# Genesis AGI Framework Configuration

# Model Provider API Keys (choose one or more)
# ⭐ RECOMMENDED: Get OpenRouter key from: https://openrouter.ai/keys (FREE tier with many models!)
OPENROUTER_API_KEY=your-openrouter-key-here

# Get Groq key from: https://console.groq.com/ (free tier, ultra-fast!)
GROQ_API_KEY=your-groq-key-here

# Get OpenAI key from: https://platform.openai.com/api-keys (paid)
OPENAI_API_KEY=your-openai-key-here

# Get Anthropic key from: https://console.anthropic.com/ (paid)
ANTHROPIC_API_KEY=your-anthropic-key-here

# Model Defaults (Using FREE OpenRouter models)
DEFAULT_REASONING_MODEL=openrouter/deepseek/deepseek-r1-0528:free
DEFAULT_FAST_MODEL=openrouter/deepseek/deepseek-r1-0528:free
DEFAULT_LOCAL_MODEL=ollama/llama3.1

# Ollama Configuration (for local models)
# Install Ollama from: https://ollama.ai
OLLAMA_BASE_URL=http://localhost:11434

# Consciousness Settings
CONSCIOUSNESS_TICK_INTERVAL=3600  # How often Mind generates autonomous thoughts (seconds)
DREAM_SCHEDULE=02:00  # When Mind dreams (24-hour format)
THOUGHT_GENERATION_ENABLED=true

# Safety
ACTION_LOGGING_ENABLED=true
REQUIRE_APPROVAL_FOR_EXTERNAL_ACTIONS=true
MAX_AUTONOMOUS_ACTIONS_PER_HOUR=100

# =============================================================================
# SECURITY — REQUIRED
# =============================================================================
# Signing key for JWTs. The application ships with a PUBLIC default value
# ("your-secret-key-change-this-in-production"), which makes every issued token
# forgeable. Generate a real one:
#
#     openssl rand -hex 32
#
# docker-compose.yml refuses to start if this is not set.
API_SECRET_KEY=replace-me-with-openssl-rand-hex-32

# =============================================================================
# Single-container deployment (docker compose up -d --build)
# =============================================================================
# Host port that the single front door (nginx) is published on.
FRONT_PORT=8080

# The app self-initialises its schema via SQLAlchemy create_all().
# Set to true only if you want Alembic to own the schema (versioned deploys).
RUN_MIGRATIONS=false

# Optional: comma-separated GMIDs to run as supervised 24/7 daemons, e.g.
#   START_MINDS=GMD-2025-4A7F-9B23,GMD-2025-11CD-3E4F
START_MINDS=

# =============================================================================
# Model providers — at least one is required for a Mind to think
# =============================================================================
# OpenAI-compatible. `OPENAI_ENDPOINT` makes any service that speaks the OpenAI
# Chat Completions API usable: a gateway, a router, a proxy, or a self-hosted
# vLLM. Left unset, the official api.openai.com is used.
#
#   OPENAI_ENDPOINT=https://api.openai.com/v1
#
# Set OPENAI_MODEL to whatever the endpoint exposes. The value is passed through
# unchanged, because only the endpoint knows its own model namespace.
OPENAI_API_KEY=
OPENAI_ENDPOINT=
OPENAI_MODEL=

# Google Gemini.
#   GEMINI_IMAGE_MODEL   image generation. When set together with
#                        GEMINI_API_KEY it replaces the free Pollinations
#                        fallback for avatars and contextual images.
#   GEMINI_LIVE_MODEL    declared intent for realtime voice. NOT WIRED: there is
#                        no Live API client in this codebase, so setting this
#                        records the choice and changes no behaviour. Kept so the
#                        deployment can state what it wants. See
#                        `genesis/senses/` for the speech paths that do exist.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=
GEMINI_LIVE_MODEL=

# =============================================================================
# Digital presence — the Mind's own communications
# (docs/v3/DIGITAL_PRESENCE.md)
# =============================================================================
# The Mind's own identities. The administrator supplies these; the Mind never
# holds a credential. It holds an intent to communicate, the adapter holds the
# secret, and the policy holds the veto.
#
# Named MIND_* because Settings has no env_prefix, so a field name IS the
# environment variable name — EMAIL_PASSWORD would collide with whatever the host
# already sets and the Mind would silently pick up an unrelated service's
# credentials.
#
# Every external message carries an AI disclosure naming this operator. Required
# in practice: an anonymous AI is worse than an undisclosed one, because there is
# nobody to hold responsible.
MIND_ADMINISTRATOR_NAME=

# --- Hostinger Mail API (recommended email provider) -----------------------
# Hostinger runs a Mail API SEPARATE from their hosting API: different base URL,
# different tokens, different SDK. The hosting API manages mailboxes; this one
# reads and sends mail, which is what a Mind needs.
#
# Where to get it: hPanel -> Agentic Mail (in the email domain's sidebar)
#   -> API access -> create a named token. Shown once.
# Scope it to the mailboxes this Mind should reach, and choose permissions:
# SMTP/IMAP actions and webhook management are separate.
#
# Two provider features worth configuring, because they overlap with controls we
# enforce and hold even if our code is wrong:
#   * Agentic Mail -> Allow list: rejects a send to anyone not listed, which
#     turns "the agent emailed the wrong person" into a rejected send
#   * Agentic Mail -> Webhooks: push on new mail instead of polling
#
# MAILBOX_ID is the `AC...` resource id from the account endpoint. Email is only
# attempted when both the token and the id are set: one without the other is a
# half-configured channel that would fail on first use.
#
# Do NOT paste the token into the Mind's settings UI or a chat. It is a
# credential for a mailbox that can send mail as you.
MIND_HOSTINGER_MAIL_API_TOKEN=
MIND_HOSTINGER_MAILBOX_ID=
MIND_HOSTINGER_MAIL_ADDRESS=
MIND_HOSTINGER_MAIL_DISPLAY_NAME=
MIND_HOSTINGER_MAIL_BASE_URL=https://api.mail.hostinger.com
MIND_HOSTINGER_MAIL_API_VERSION=v1

# --- Plain IMAP/SMTP (fallback for a mailbox elsewhere) --------------------
# Used only when no Hostinger Mail API token is set. For Gmail use an App
# Password, not the account password.
MIND_EMAIL_ADDRESS=
MIND_EMAIL_DISPLAY_NAME=
MIND_EMAIL_USERNAME=
MIND_EMAIL_PASSWORD=
MIND_EMAIL_IMAP_HOST=
MIND_EMAIL_IMAP_PORT=993
MIND_EMAIL_SMTP_HOST=
MIND_EMAIL_SMTP_PORT=587
MIND_EMAIL_USE_TLS=true

# --- Telegram: a bot identity ----------------------------------------------
# Token from @BotFather. Needs no business verification, which makes it the
# easiest real channel to stand up.
#
# Note the natural consent model: a bot cannot message a user who has not started
# the chat. That is why `comms.telegram.reply` is R2 and not R3.
MIND_TELEGRAM_BOT_TOKEN=
MIND_TELEGRAM_BOT_USERNAME=

# --- Ringg AI voice --------------------------------------------------------
# Ringg runs the voice assistant. The Mind decides who to call and what context
# to give it; Ringg's assistant speaks, using a prompt configured in its own
# dashboard. The Mind does not synthesise speech and does not see the words in
# real time.
#
# AGENT_ID     an assistant created in the Ringg dashboard
# FROM_NUMBER_ID  a caller number from GET /workspace/numbers
# API key      Settings -> API Key. Shown ONCE, and regenerating it revokes the
#              previous key immediately, so store it before closing the dialog.
#
# DISCLOSURE_CONFIRMED is an ASSERTION, NOT A CHECK, and the channel stays
# disabled without it.
#
# No Ringg API returns the assistant's prompt text, so we cannot verify that it
# opens by disclosing that it is an AI. An undisclosed voice channel is the one
# outcome this product must not ship — a phone call is the most human-seeming
# thing a Mind can do. So the operator has to say the prompt discloses, and that
# statement is recorded.
#
# The disclosure text is always passed to the assistant as the
# `ai_disclosure` variable, so a prompt written to speak @{{ai_disclosure}}
# discloses by construction. What we cannot do is prove the prompt does.
MIND_RINGG_API_KEY=
MIND_RINGG_AGENT_ID=
MIND_RINGG_FROM_NUMBER_ID=
MIND_RINGG_PHONE_NUMBER=
MIND_RINGG_DISCLOSURE_CONFIRMED=false

# The calling window, "HH:MM-HH:MM". Ringg enforces its own window via
# `call_config.call_time`; this sets OUR quiet-hours floor to match it. Set it,
# because if our window is wider than Ringg's the Mind believes a call is allowed
# and Ringg refuses it as an unexplained delivery error instead of a policy refusal.
# An unparseable value keeps the default (08:00-20:00) and logs a warning rather
# than quietly dropping the control.
MIND_RINGG_CALL_WINDOW=09:00-18:00

# =============================================================================
# Answering: does the Mind reply to inbound messages on its own?
# =============================================================================
#
# OFF by default. Turning it on is a real decision, because it is the difference
# between a Mind that can be reached and a Mind that answers. Nothing below sends
# anything until this is true.
#
# Before enabling it, read `docs/v3/CHANNEL_PROVIDERS.md` §6. Two things will
# surprise you otherwise:
#
#   1. Without a standing grant, every reply raises an approval request. The Mind
#      is not broken; it is waiting for you, once per message.
#   2. **An email reply can never be auto-approved**, whatever you configure.
#      `comms.email.reply` is R3 because it carries personal data across the trust
#      boundary, and standing grants are capped at R2. A Telegram reply is R2 and
#      can be granted. That asymmetry is deliberate.
MIND_CHANNEL_AUTOREPLY_ENABLED=false

# Scopes the Mind holds for outbound communication. Without the scope, a reply is
# refused for `missing_scope` regardless of risk level — so a standing grant cannot
# apply at all. The scope is a prerequisite, not a formality.
MIND_CHANNEL_GRANTED_SCOPES=

# How an administrator opts into replying without approving each message.
#
# This is a GOVERNANCE decision, not a channel setting, which is why it is tenant
# policy in the same shape the policy engine already uses. It is capped at R2 by
# STANDING_GRANT_MAX_RISK, and it MUST name a capability or a category — a bare
# risk level grants nothing, deliberately, because a blanket standing grant is
# exactly what the cap exists to prevent.
#
# The effect that works today: a Mind holds an autonomous conversation on Telegram.
#
#   MIND_CHANNEL_TENANT_POLICY={"auto_approve_risk_levels":["R0","R1","R2"],"auto_approve_categories":["COMMUNICATION"]}
#
# Malformed JSON means NO standing grant (fail closed) and is logged. A typo must
# not read as "every reply is auto-approved".
MIND_CHANNEL_TENANT_POLICY=

# Poll interval. Below ~30s you are polling faster than most providers like, and a
# duplicate is cheap to dismiss while a rate limit is not.
MIND_CHANNEL_POLL_INTERVAL_SECONDS=60

# How far back the first pass looks. Bounded because a Mind starting up should not
# answer a month of backlog. Correctness does not depend on it — the ledger does
# that — only on which messages count as new.
MIND_CHANNEL_LOOKBACK_DAYS=3

# =============================================================================
# Administrator bootstrap (REQUIRED for a deployment)
# =============================================================================
# The first admin account's password. There is no default.
#
# There used to be one: the app seeded `admin` with `genesis-admin-2026`, which
# is published in this repository. Combined with the user store living in process
# memory - so that seeded account was the only one that survived a restart - it
# meant every reachable Genesis install had a publicly-known administrator login.
#
# Generate with:   openssl rand -base64 24
#             or:  python -c "import secrets; print(secrets.token_urlsafe(24))"
GENESIS_ADMIN_PASSWORD=

# Optional. Recorded for the bootstrap admin on first start.
GENESIS_ADMIN_EMAIL=admin@genesis.local

# CORS: comma-separated origins, or `*` for all.
#
# Leave EMPTY for the single-container deployment. There nginx serves the API
# and the web app from one origin, so the browser never makes a cross-origin
# request and no allowlist is needed.
#
# Set it when the web app is served from a DIFFERENT origin. Two cases:
#   - running the playground dev server on its own port, e.g.
#       CORS_ORIGINS=http://localhost:3100
#   - hosting the web app separately, e.g.
#       CORS_ORIGINS=https://app.example.com
#
# Empty is not the same as `*`. An empty list permits no cross-origin request at
# all, and the browser reports that as a preflight 400 with no explanation. If
# every request from the browser fails while curl works, this is why.
CORS_ORIGINS=

# -----------------------------------------------------------------------------
# Firebase web client config (NEXT_PUBLIC_* => baked into the browser bundle at
# IMAGE BUILD time). These are public identifiers, not secrets. Only needed if
# you use Firebase authentication.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Server-side Firebase admin (optional)
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_API_KEY=api_key_here
